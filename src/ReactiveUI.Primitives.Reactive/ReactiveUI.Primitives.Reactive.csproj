<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- System.Reactive-flavoured leaf: recompiles the shared Primitives source with RxVoid->Unit and
         ISequencer->IScheduler (aliases + REACTIVE_SHIM come from Directory.Build.props via the name suffix). -->
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <PackageDescription>ReactiveUI.Primitives recompiled against System.Reactive's Unit and IScheduler for seamless interop with System.Reactive consumers.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Primitives.Core\ReactiveUI.Primitives.Core.csproj" />
  </ItemGroup>

  <!-- The RxVoid/ISequencer-aware shared source, compiled here under the .Reactive namespace (REACTIVE_SHIM). -->
  <ItemGroup>
    <Compile Include="..\Primitives.Shared\**\*.cs" Link="Primitives.Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The shared source shifts to ReactiveUI.Primitives.Reactive.* under REACTIVE_SHIM. These imports let the
       shifted files reach both their shifted siblings and the non-shifted Core siblings without per-file usings. -->
  <ItemGroup>
    <Using Include="ReactiveUI.Primitives" />
    <Using Include="ReactiveUI.Primitives.Advanced" />
    <Using Include="ReactiveUI.Primitives.Reactive" />
    <Using Include="ReactiveUI.Primitives.Reactive.Advanced" />
    <Using Include="ReactiveUI.Primitives.Core" />
    <Using Include="ReactiveUI.Primitives.Concurrency" />
    <Using Include="ReactiveUI.Primitives.Disposables" />
    <Using Include="ReactiveUI.Primitives.Signals" />
    <Using Include="ReactiveUI.Primitives.Reactive.Core" />
    <Using Include="ReactiveUI.Primitives.Reactive.Concurrency" />
    <Using Include="ReactiveUI.Primitives.Reactive.Signals" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReactiveUI.Primitives.Reactive.Tests" />
  </ItemGroup>

</Project>
