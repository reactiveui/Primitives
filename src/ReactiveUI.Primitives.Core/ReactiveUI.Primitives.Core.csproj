<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Type-agnostic shared layer: no RxVoid / ISequencer, so no platform-specific sequencers and no
         per-leaf aliasing. Compiled once and referenced by both the lean and the Reactive leaf. -->
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <!-- Keep the default namespace ReactiveUI.Primitives (not ...Core) so split-out types share the root. -->
    <RootNamespace>ReactiveUI.Primitives</RootNamespace>
    <PackageDescription>Type-agnostic core primitives shared by ReactiveUI.Primitives and ReactiveUI.Primitives.Reactive.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReactiveUI.Primitives.Tests"/>
    <InternalsVisibleTo Include="ReactiveUI.Primitives.Core.Tests"/>
    <InternalsVisibleTo Include="ReactiveUI.Primitives.Extensions.Tests"/>
    <InternalsVisibleTo Include="ReactiveUI.Primitives.Async.Tests"/>
    <InternalsVisibleTo Include="ReactiveUI.Primitives.Blazor.Tests"/>
    <InternalsVisibleTo Include="ReactiveUI.Primitives.Extensions.Reactive.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Disposables\ReactiveUI.Disposables.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.Bcl.TimeProvider"/>
    <PackageReference Include="System.Threading.Channels"/>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe"/>
    <PackageReference Include="System.ComponentModel.Annotations"/>
    <PackageReference Include="System.Buffers"/>
    <PackageReference Include="System.Memory"/>
    <PackageReference Include="System.Collections.Immutable"/>
  </ItemGroup>

  <ItemGroup Condition="$(TargetFrameworkIdentifier) == '.NETFramework'">
    <Compile Remove="Advanced\AsyncEnumerableSignal{T}.cs"/>
    <Compile Remove="Advanced\IAsyncEnumerableBackedSignal{T}.cs"/>
    <Compile Remove="Core\CoreCompositeFormats.cs"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Primitives.Extensions.Shared\Internal\InvalidOperationExceptionHelper.cs" Link="Extensions\InvalidOperationExceptionHelper.cs"/>
    <Compile Include="..\ReactiveUI.Primitives.Extensions.Core\**\*.cs" Link="Extensions\%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
