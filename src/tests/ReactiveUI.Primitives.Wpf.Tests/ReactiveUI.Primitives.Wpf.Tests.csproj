<Project Sdk="Microsoft.NET.Sdk">

  <!-- DispatcherSequencer wraps the concrete WPF System.Windows.Threading.Dispatcher, so this project
       targets the Windows TFMs and builds anywhere (EnableWindowsTargeting). The dispatcher tests need a
       real Windows desktop runtime, so they are compiled only on Windows builds (windows CI leg, or under
       a Wine .NET-windows runtime). On non-Windows builds only the API approval test is compiled. -->
  <PropertyGroup>
    <TargetFrameworks>$(WindowsNetTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PublicApiGenerator" />
    <Compile Include="..\Shared\ApiApprovalExtensions.cs" Link="ApiApprovalExtensions.cs" />
  </ItemGroup>

  <!-- Exclude the real-dispatcher tests from non-Windows builds. -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Remove="DispatcherSequencerTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ReactiveUI.Primitives.Wpf\ReactiveUI.Primitives.Wpf.csproj" />
  </ItemGroup>

</Project>
