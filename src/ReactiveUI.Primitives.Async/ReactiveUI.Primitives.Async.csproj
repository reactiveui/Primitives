<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReactiveUI.Primitives.Tests"/>
    <InternalsVisibleTo Include="$(AssemblyName).Tests"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="ReactiveUI.Primitives.Concurrency"/>
    <Using Include="ReactiveUI.Primitives.Async.Advanced"/>
    <Using Include="ReactiveUI.Primitives.Async.Helpers"/>
  </ItemGroup>

  <!-- The RxVoid/ISequencer-aware shared async source, compiled here under the lean namespace (no REACTIVE_SHIM). -->
  <ItemGroup>
    <Compile Include="..\Primitives.Async.Shared\**\*.cs" Link="Primitives.Async.Shared\%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Primitives\ReactiveUI.Primitives.csproj"/>
    <ProjectReference Include="..\ReactiveUI.Primitives.Async.Core\ReactiveUI.Primitives.Async.Core.csproj"/>
  </ItemGroup>

</Project>
