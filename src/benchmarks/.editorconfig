[*.cs]

###################
# Benchmark harness relaxations
#
# A benchmark class is a harness the runner instantiates and drives; nobody stops on one in a
# debugger to read a summary of it. The models these benchmarks observe still carry a display
# attribute where it earns its place.
###################
dotnet_diagnostic.SST1449.severity = none # TODO re-assess: harness entry points and smoke runners report to the console; remove that output from the benchmarks and re-enable
dotnet_diagnostic.SST2334.severity = none # Harness types are driven by the runner, not inspected
dotnet_diagnostic.SST2410.severity = none # The runner owns the lifetime of objects a benchmark creates
