<Project Sdk="Microsoft.NET.Sdk">

  <!-- ControlSequencer wraps a concrete System.Windows.Forms.Control, so this project targets the Windows
       TFMs and builds anywhere (EnableWindowsTargeting). The dispatcher tests need a real Windows desktop
       runtime, so they are compiled only on Windows builds (windows CI leg, or under a Wine .NET-windows
       runtime). On non-Windows builds only the API approval test is compiled. -->
  <PropertyGroup>
    <TargetFrameworks>$(WindowsNetTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PublicApiGenerator" />
    <Compile Include="..\Shared\ApiApprovalExtensions.cs" Link="ApiApprovalExtensions.cs" />
  </ItemGroup>

  <!-- Exclude the real-dispatcher tests from non-Windows builds. -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Remove="ControlSequencerTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ReactiveUI.Primitives.WinForms\ReactiveUI.Primitives.WinForms.csproj" />
  </ItemGroup>

</Project>
