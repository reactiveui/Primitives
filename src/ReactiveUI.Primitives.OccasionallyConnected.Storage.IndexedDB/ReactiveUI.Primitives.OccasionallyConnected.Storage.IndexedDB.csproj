<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- Microsoft.JSInterop 10.0.12 in this repo supports net10.0+, so browser-only IndexedDB targets only those TFMs. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>ReactiveUI.Primitives.OccasionallyConnected.Storage.IndexedDB</RootNamespace>
    <PackageDescription>IndexedDB-backed local storage for browser-hosted occasionally connected streams.</PackageDescription>
    <EnableSystemTextJsonSourceGenerator>true</EnableSystemTextJsonSourceGenerator>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.JSInterop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Primitives.OccasionallyConnected.Core\ReactiveUI.Primitives.OccasionallyConnected.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
