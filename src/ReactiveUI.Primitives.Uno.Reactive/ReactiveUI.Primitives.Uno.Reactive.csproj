<Project Sdk="Uno.Sdk">

  <!-- System.Reactive-flavoured Uno leaf: the WinUI.Reactive scheduler compiled for every Uno head.
       REACTIVE_SHIM + the System.Reactive dependency come from Directory.Build.props via the name suffix. -->
  <PropertyGroup>
    <TargetFrameworks>$(UnoTargetFrameworks)</TargetFrameworks>
    <OutputType>Library</OutputType>
    <!-- Uno.Sdk does not pack a library unless asked. -->
    <IsPackable>true</IsPackable>
    <!-- The implicit packages include Uno.Resizetizer, which adds window-icon helpers to a library's public API.
         The scheduler needs only the dispatcher queue, so it references Uno.WinUI or the Windows App SDK itself. -->
    <DisableImplicitUnoPackages>true</DisableImplicitUnoPackages>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <PackageDescription>Uno Platform dispatcher queue scheduler for ReactiveUI.Primitives, recompiled against System.Reactive's IScheduler.</PackageDescription>
    <PackageTags>system.reactive;rx;reactive;primitives;uno;winui;dispatcher-queue;scheduler</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ReactiveUI.Primitives.WinUI.Reactive\Concurrency\**\*.cs" Link="Concurrency\%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="ReactiveUI.Primitives.Reactive.Concurrency"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Primitives.Reactive\ReactiveUI.Primitives.Reactive.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <PackageReference Include="Uno.WinUI"/>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Microsoft.WindowsAppSDK"/>
  </ItemGroup>

</Project>
