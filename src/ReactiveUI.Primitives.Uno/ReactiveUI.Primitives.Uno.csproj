<Project Sdk="Uno.Sdk">

  <!-- The WinUI dispatcher queue sequencer, compiled for every Uno head. Uno.WinUI and the Windows App SDK both
       declare Microsoft.UI.Dispatching.DispatcherQueue, so the WinUI source builds unchanged. -->
  <PropertyGroup>
    <TargetFrameworks>$(UnoTargetFrameworks)</TargetFrameworks>
    <OutputType>Library</OutputType>
    <!-- The implicit packages include Uno.Resizetizer, which adds window-icon helpers to a library's public API.
         The sequencer needs only the dispatcher queue, so it references Uno.WinUI or the Windows App SDK itself. -->
    <DisableImplicitUnoPackages>true</DisableImplicitUnoPackages>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <PackageDescription>Uno Platform dispatcher queue integration sequencers for ReactiveUI.Primitives.</PackageDescription>
    <PackageTags>system.reactive;rx;reactive;primitives;uno;winui;dispatcher-queue;scheduler;sequencer</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ReactiveUI.Primitives.WinUI\Concurrency\**\*.cs" Link="Concurrency\%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Primitives\ReactiveUI.Primitives.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <PackageReference Include="Uno.WinUI"/>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Microsoft.WindowsAppSDK"/>
  </ItemGroup>

</Project>
