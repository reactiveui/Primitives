<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <!-- Pass -p:BenchmarkPlatform=windows or unix to compile the other platform's configs. -->
    <BenchmarkPlatform Condition="'$(BenchmarkPlatform)' == '' and $([MSBuild]::IsOsPlatform('Windows'))">windows</BenchmarkPlatform>
    <BenchmarkPlatform Condition="'$(BenchmarkPlatform)' == ''">unix</BenchmarkPlatform>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RunAnalyzers>true</RunAnalyzers>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
    <!-- Roslyn is not trim- or AOT-friendly, and these benchmarks host it in-process. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- The compiler the benchmarks host. Deliberately newer than the 4.8 the generator is built against:
         that is the direction consumers actually run it in, so it is the direction worth measuring. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Configs\**\*.cs" Link="Configs\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Platforms\$(BenchmarkPlatform)\**\*.cs" Link="Platforms\$(BenchmarkPlatform)\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(BenchmarkPlatform)' == 'windows'">
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced as an ordinary assembly rather than an analyzer: the benchmarks drive the generator
         themselves through CSharpGeneratorDriver instead of letting the build run it. -->
    <ProjectReference Include="..\..\ReactiveUI.Primitives.ObservableEvents\ReactiveUI.Primitives.ObservableEvents.csproj"/>
    <!-- The corpus compiles against the lean provider, which is what the generated wrappers name. -->
    <ProjectReference Include="..\..\ReactiveUI.Primitives\ReactiveUI.Primitives.csproj"/>
  </ItemGroup>

</Project>
