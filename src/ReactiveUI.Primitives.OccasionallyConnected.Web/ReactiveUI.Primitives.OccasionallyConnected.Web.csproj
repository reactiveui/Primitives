<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>ReactiveUI.Primitives.OccasionallyConnected.Web</RootNamespace>
    <PackageDescription>Browser lifecycle and IndexedDB composition for occasionally connected streams.</PackageDescription>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.JSInterop" />
    <ProjectReference Include="..\ReactiveUI.Primitives.OccasionallyConnected.Storage.IndexedDB\ReactiveUI.Primitives.OccasionallyConnected.Storage.IndexedDB.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
