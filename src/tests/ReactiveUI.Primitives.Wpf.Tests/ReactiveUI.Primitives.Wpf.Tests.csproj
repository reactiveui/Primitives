<Project Sdk="Microsoft.NET.Sdk">

  <!-- DispatcherSequencer wraps the concrete WPF System.Windows.Threading.Dispatcher. The project targets
       plain .NET everywhere and adds the -windows TFMs only on Windows, so the test host launches on the
       cross-platform CI leg. The windows TFM (via the Choose below) turns on UseWPF, references the WPF
       library, and compiles the real dispatcher tests + API approval; the cross-platform build compiles
       only the API approval test, which is a no-op there (the surface is approved on the windows leg). -->
  <PropertyGroup>
    <TargetFrameworks>$(NetTargetFrameworks)</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(WindowsNetTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The dispatcher tests need WPF types; include them only on the windows TFM (see the Choose). -->
  <ItemGroup>
    <Compile Remove="DispatcherSequencerTests.cs" />
  </ItemGroup>

  <Choose>
    <When Condition="$(TargetFramework.EndsWith('-windows'))">
      <PropertyGroup>
        <UseWPF>true</UseWPF>
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
      </PropertyGroup>
      <ItemGroup>
        <PackageReference Include="PublicApiGenerator" />
        <Compile Include="..\Shared\ApiApprovalExtensions.cs" Link="ApiApprovalExtensions.cs" />
        <ProjectReference Include="..\..\ReactiveUI.Primitives.Wpf\ReactiveUI.Primitives.Wpf.csproj" />
        <Compile Include="DispatcherSequencerTests.cs" />
      </ItemGroup>
    </When>
  </Choose>

</Project>
