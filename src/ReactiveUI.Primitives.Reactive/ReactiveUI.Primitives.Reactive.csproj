<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- System.Reactive-flavoured leaf: recompiles the shared Primitives source with RxVoid->Unit and
         ISequencer->IScheduler (aliases + REACTIVE_SHIM come from Directory.Build.props via the name suffix). -->
    <TargetFrameworks>$(LibraryTargetFrameworks);$(AndroidPrimitivesTargetFrameworks)</TargetFrameworks>
    <!-- Apple legs need the iOS/macOS workloads, which only restore on Windows/macOS; build them there (or in the dockur guest). -->
    <TargetFrameworks Condition="$([MSBuild]::IsOsPlatform('Windows')) or $([MSBuild]::IsOsPlatform('OSX'))">$(TargetFrameworks);$(ApplePrimitivesTargetFrameworks)</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tvos'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">12.0</SupportedOSPlatformVersion>
    <PackageDescription>ReactiveUI.Primitives recompiled against System.Reactive's Unit and IScheduler for seamless interop with System.Reactive consumers.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Primitives.Core\ReactiveUI.Primitives.Core.csproj" />
    <ProjectReference Include="..\ReactiveUI.Primitives.Extensions.Core\ReactiveUI.Primitives.Extensions.Core.csproj" />
  </ItemGroup>

  <!-- Platform sequencers compile only on their matching OS-platform TFM (the coalescing IScheduler base below
       is included on the same TFMs). The library/windows TFMs never see this code, so the windows-only platform
       .Reactive packages (Wpf/WinForms/...) carry no duplicate of the shared base type. -->
  <ItemGroup>
    <Compile Remove="Platforms\**\*.cs" />
    <None Include="Platforms\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Compile Include="Platforms\android\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tvos' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
    <Compile Include="Platforms\apple\**\*.cs" />
  </ItemGroup>

  <!-- The coalescing IScheduler base shared by every platform .Reactive package, included here only on the
       apple/android TFMs that carry a concrete sequencer (CoalescingDispatchScheduler). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tvos' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
    <Compile Include="..\Primitives.Platform.Reactive.Shared\**\*.cs" Link="Primitives.Platform.Reactive.Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- WasmScheduler compiles on every TFM and shares its run/cancel core with the mobile DispatchWorkItem via
       DispatchWorkItemBase. Pull just that base type in on the non-platform (library) TFMs, where the whole shared
       folder above is not linked. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">
    <Compile Include="..\Primitives.Platform.Reactive.Shared\DispatchWorkItemBase.cs" Link="Primitives.Platform.Reactive.Shared\DispatchWorkItemBase.cs" />
  </ItemGroup>

  <!-- The RxVoid/ISequencer-aware shared source, compiled here under the .Reactive namespace (REACTIVE_SHIM). -->
  <ItemGroup>
    <Compile Include="..\Primitives.Shared\**\*.cs" Link="Primitives.Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The RxVoid/ISequencer-aware shared Extensions source, compiled here under the .Reactive namespace (REACTIVE_SHIM). -->
  <ItemGroup>
    <Compile Include="..\Primitives.Extensions.Shared\**\*.cs" Link="Primitives.Extensions.Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The shared source shifts to ReactiveUI.Primitives.Reactive.* under REACTIVE_SHIM. These imports let the
       shifted files reach both their shifted siblings and the non-shifted Core siblings without per-file usings. -->
  <ItemGroup>
    <Using Include="ReactiveUI.Primitives" />
    <Using Include="ReactiveUI.Primitives.Advanced" />
    <Using Include="ReactiveUI.Primitives.Reactive" />
    <Using Include="ReactiveUI.Primitives.Reactive.Advanced" />
    <Using Include="ReactiveUI.Primitives.Core" />
    <Using Include="ReactiveUI.Primitives.Concurrency" />
    <Using Include="ReactiveUI.Primitives.Disposables" />
    <Using Include="ReactiveUI.Primitives.Signals" />
    <Using Include="ReactiveUI.Primitives.Reactive.Core" />
    <Using Include="ReactiveUI.Primitives.Reactive.Concurrency" />
    <Using Include="ReactiveUI.Primitives.Reactive.Signals" />

    <Using Include="ReactiveUI.Primitives.Extensions.Reactive"/>
    <Using Include="ReactiveUI.Primitives.Extensions.Reactive.Internal"/>
    <Using Include="ReactiveUI.Primitives.Extensions.Reactive.Operators"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReactiveUI.Primitives.Reactive.Tests" />
    <InternalsVisibleTo Include="ReactiveUI.Primitives.Extensions.Reactive.Tests" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
    <PackageReference Include="System.ComponentModel.Annotations" />
    <PackageReference Include="System.Buffers" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>

</Project>
