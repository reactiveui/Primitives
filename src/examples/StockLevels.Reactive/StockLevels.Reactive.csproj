<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../ReactiveUI.Primitives.Async.Reactive/ReactiveUI.Primitives.Async.Reactive.csproj" />
    <!-- The generated R3 bridge constructs BCL signals with ReactiveUI.Primitives.Signal.Create. -->
    <ProjectReference Include="../../ReactiveUI.Primitives/ReactiveUI.Primitives.csproj" />
    <Compile Include="../StockLevels/*.cs" Link="%(Filename)%(Extension)" />
    <Using Include="ReactiveUI.Primitives.Reactive" />
    <Using Include="ReactiveUI.Primitives.Signals" />
    <Using Include="System.Reactive.Concurrency.HistoricalScheduler" Alias="StockClock" />
    <ProjectReference Include="../../ReactiveUI.Primitives.ObservableEvents/ReactiveUI.Primitives.ObservableEvents.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../ReactiveUI.Primitives.R3Bridge.Generator/ReactiveUI.Primitives.R3Bridge.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="R3" />
    <InternalsVisibleTo Include="ReactiveUI.Primitives.Async.Reactive.Tests" />
  </ItemGroup>
</Project>
